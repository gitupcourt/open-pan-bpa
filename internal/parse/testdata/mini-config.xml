<?xml version="1.0"?>
<!-- Synthetic test configuration. Hand-written for unit tests; resembles no
     real device. Do not add real-device content here (see SECURITY.md). -->
<config version="11.1.0">
  <mgt-config>
    <password-complexity>
      <enabled>yes</enabled>
      <minimum-length>8</minimum-length>
      <minimum-uppercase-letters>1</minimum-uppercase-letters>
      <minimum-lowercase-letters>1</minimum-lowercase-letters>
      <minimum-numeric-letters>0</minimum-numeric-letters>
      <block-username-inclusion>no</block-username-inclusion>
    </password-complexity>
  </mgt-config>
  <shared>
    <server-profile>
      <ldap>
        <entry name="good-ldap">
          <server><entry name="a"><address>ldap1.test</address></entry><entry name="b"><address>ldap2.test</address></entry></server>
          <ssl>yes</ssl>
          <verify-server-certificate>yes</verify-server-certificate>
        </entry>
        <entry name="bad-ldap">
          <server><entry name="only"><address>ldap.test</address></entry></server>
          <ssl>no</ssl>
        </entry>
      </ldap>
      <syslog>
        <entry name="ssl-syslog">
          <server><entry name="s1"><transport>SSL</transport></entry></server>
        </entry>
        <entry name="udp-syslog">
          <server><entry name="s1"><transport>UDP</transport></entry></server>
        </entry>
      </syslog>
      <tacplus>
        <entry name="tac-chap"><protocol><CHAP/></protocol><server><entry name="t"/></server></entry>
      </tacplus>
    </server-profile>
    <certificate>
      <entry name="dual-role-ca">
        <forward-trust-ca>yes</forward-trust-ca>
        <forward-untrust-ca>yes</forward-untrust-ca>
      </entry>
      <entry name="trust-only-ca">
        <forward-trust-ca>yes</forward-trust-ca>
      </entry>
    </certificate>
    <ssl-tls-service-profile>
      <entry name="mgmt-tls">
        <protocol-settings><min-version>tls1-2</min-version><max-version>max</max-version></protocol-settings>
      </entry>
      <entry name="old-tls">
        <protocol-settings><min-version>tls1-0</min-version><max-version>tls1-2</max-version></protocol-settings>
      </entry>
    </ssl-tls-service-profile>
    <admin-role>
      <entry name="empty-role"/>
      <entry name="real-role"><role><device><webui/></device></role></entry>
    </admin-role>
    <authentication-sequence>
      <entry name="solo-seq"><authentication-profiles><member>only-one</member></authentication-profiles></entry>
      <entry name="dual-seq"><authentication-profiles><member>first</member><member>backup</member></authentication-profiles></entry>
    </authentication-sequence>
    <log-settings>
      <system>
        <match-list>
          <entry name="all-system"><filter>All Logs</filter><send-syslog><member>siem</member></send-syslog></entry>
        </match-list>
      </system>
      <config>
        <match-list>
          <entry name="all-config"><filter>All Logs</filter><send-syslog><member>siem</member></send-syslog></entry>
        </match-list>
      </config>
    </log-settings>
    <profile-group>
      <entry name="strict-group">
        <virus><member>strict-av</member></virus>
        <spyware><member>strict-as</member></spyware>
        <vulnerability><member>strict-vp</member></vulnerability>
        <url-filtering><member>strict-url</member></url-filtering>
      </entry>
      <entry name="thin-group">
        <url-filtering><member>strict-url</member></url-filtering>
      </entry>
    </profile-group>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <hostname>TESTFW-01</hostname>
          <ntp-servers>
            <primary-ntp-server>
              <ntp-server-address>192.0.2.10</ntp-server-address>
            </primary-ntp-server>
          </ntp-servers>
          <update-schedule>
            <anti-virus><recurring><hourly><at>4</at><action>download-and-install</action></hourly></recurring></anti-virus>
            <threats><recurring><daily><at>03:00</at><action>download-and-install</action></daily></recurring></threats>
            <wildfire><recurring><real-time/></recurring></wildfire>
          </update-schedule>
        </system>
      </deviceconfig>
      <vsys>
        <entry name="vsys1">
          <zone>
            <entry name="trust">
              <network>
                <layer3><member>ethernet1/1</member></layer3>
                <zone-protection-profile>zpp-standard</zone-protection-profile>
              </network>
            </entry>
            <entry name="untrust">
              <network>
                <layer3><member>ethernet1/2</member></layer3>
              </network>
            </entry>
            <entry name="spare">
              <network/>
            </entry>
          </zone>
          <profiles>
            <virus>
              <entry name="strict-av">
                <decoder>
                  <entry name="ftp"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                  <entry name="http"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                  <entry name="http2"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                  <entry name="imap"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                  <entry name="pop3"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                  <entry name="smb"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                  <entry name="smtp"><action>reset-both</action><wildfire-action>reset-both</wildfire-action><mlav-action>reset-both</mlav-action></entry>
                </decoder>
                <mlav-engine-filebased-enabled>
                  <entry name="Windows Executables"><mlav-policy-action>enable</mlav-policy-action></entry>
                </mlav-engine-filebased-enabled>
              </entry>
              <entry name="lazy-av">
                <decoder>
                  <entry name="smtp"><action>default</action><wildfire-action>reset-server</wildfire-action></entry>
                </decoder>
                <mlav-engine-filebased-enabled>
                  <entry name="Windows Executables"><mlav-policy-action>enable(alert-only)</mlav-policy-action></entry>
                </mlav-engine-filebased-enabled>
                <application>
                  <entry name="some-app"><action>allow</action></entry>
                </application>
                <threat-exception>
                  <entry name="12345"/>
                </threat-exception>
                <packet-capture>yes</packet-capture>
              </entry>
            </virus>
            <spyware>
              <entry name="strict-as">
                <cloud-inline-analysis>yes</cloud-inline-analysis>
                <mica-engine-spyware-enabled>
                  <entry name="HTTP Command and Control detector"><inline-policy-action>reset-both</inline-policy-action></entry>
                </mica-engine-spyware-enabled>
                <rules>
                  <entry name="block-bad">
                    <action><reset-both/></action>
                    <severity><member>critical</member><member>high</member><member>medium</member></severity>
                    <packet-capture>single-packet</packet-capture>
                  </entry>
                  <entry name="watch-low">
                    <action><default/></action>
                    <severity><member>low</member><member>informational</member></severity>
                    <packet-capture>disable</packet-capture>
                  </entry>
                </rules>
                <botnet-domains>
                  <dns-security-categories>
                    <entry name="pan-dns-sec-adtracking"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-ddns"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-grayware"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-malware"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-phishing"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-proxy"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-recent"><action>sinkhole</action><log-level>default</log-level><packet-capture>single-packet</packet-capture></entry>
                    <entry name="pan-dns-sec-parked"><action>sinkhole</action><log-level>default</log-level><packet-capture>disable</packet-capture></entry>
                    <entry name="pan-dns-sec-cc"><action>sinkhole</action><log-level>high</log-level><packet-capture>extended-capture</packet-capture></entry>
                  </dns-security-categories>
                </botnet-domains>
              </entry>
              <entry name="lazy-as">
                <rules>
                  <entry name="detect-only">
                    <action><alert/></action>
                    <severity><member>critical</member></severity>
                    <packet-capture>disable</packet-capture>
                  </entry>
                </rules>
                <threat-exception>
                  <entry name="99999"/>
                </threat-exception>
              </entry>
            </spyware>
            <vulnerability>
              <entry name="strict-vp">
                <cloud-inline-analysis>yes</cloud-inline-analysis>
                <rules>
                  <entry name="block-exploits">
                    <action><reset-both/></action>
                    <severity><member>critical</member><member>high</member><member>medium</member></severity>
                    <host>any</host>
                    <packet-capture>single-packet</packet-capture>
                  </entry>
                  <entry name="watch-low">
                    <action><default/></action>
                    <severity><member>low</member><member>informational</member></severity>
                    <host>any</host>
                    <packet-capture>disable</packet-capture>
                  </entry>
                </rules>
              </entry>
              <entry name="lazy-vp">
                <rules>
                  <entry name="default-crit">
                    <action><default/></action>
                    <severity><member>critical</member></severity>
                    <host>client</host>
                    <packet-capture>disable</packet-capture>
                  </entry>
                </rules>
              </entry>
            </vulnerability>
            <decryption>
              <entry name="tight-dp">
                <ssl-forward-proxy>
                  <auto-include-altname>yes</auto-include-altname>
                  <block-client-cert>yes</block-client-cert>
                  <block-expired-certificate>yes</block-expired-certificate>
                  <block-if-hsm-unavailable>yes</block-if-hsm-unavailable>
                  <block-if-no-resource>yes</block-if-no-resource>
                  <block-timeout-cert>yes</block-timeout-cert>
                  <block-unknown-cert>yes</block-unknown-cert>
                  <block-unsupported-cipher>yes</block-unsupported-cipher>
                  <block-unsupported-version>yes</block-unsupported-version>
                  <block-untrusted-issuer>yes</block-untrusted-issuer>
                  <restrict-cert-exts>yes</restrict-cert-exts>
                  <strip-alpn>no</strip-alpn>
                </ssl-forward-proxy>
                <ssl-inbound-proxy>
                  <block-if-hsm-unavailable>yes</block-if-hsm-unavailable>
                  <block-if-no-resource>yes</block-if-no-resource>
                  <block-tls13-downgrade-no-resource>yes</block-tls13-downgrade-no-resource>
                  <block-unsupported-cipher>yes</block-unsupported-cipher>
                  <block-unsupported-version>yes</block-unsupported-version>
                </ssl-inbound-proxy>
                <ssl-no-proxy>
                  <block-expired-certificate>yes</block-expired-certificate>
                  <block-untrusted-issuer>yes</block-untrusted-issuer>
                </ssl-no-proxy>
                <ssh-proxy>
                  <block-if-no-resource>yes</block-if-no-resource>
                  <block-ssh-errors>yes</block-ssh-errors>
                  <block-unsupported-alg>yes</block-unsupported-alg>
                  <block-unsupported-version>yes</block-unsupported-version>
                </ssh-proxy>
                <ssl-protocol-settings>
                  <min-version>tls1-2</min-version>
                  <max-version>max</max-version>
                  <enc-algo-3des>no</enc-algo-3des>
                  <enc-algo-rc4>no</enc-algo-rc4>
                  <enc-algo-aes-128-cbc>no</enc-algo-aes-128-cbc>
                  <enc-algo-aes-256-cbc>no</enc-algo-aes-256-cbc>
                  <enc-algo-aes-128-gcm>no</enc-algo-aes-128-gcm>
                  <auth-algo-sha1>no</auth-algo-sha1>
                  <keyxchg-algo-pqc-standardized>yes</keyxchg-algo-pqc-standardized>
                </ssl-protocol-settings>
              </entry>
              <entry name="loose-dp">
                <ssl-protocol-settings>
                  <min-version>tls1-0</min-version>
                </ssl-protocol-settings>
              </entry>
            </decryption>
            <url-filtering>
              <entry name="strict-url">
                <block>
                  <member>command-and-control</member><member>compromised-website</member><member>grayware</member><member>malware</member><member>phishing</member><member>ransomware</member><member>scanning-activity</member>
                  <member>abused-drugs</member><member>adult</member><member>copyright-infringement</member><member>extremism</member><member>gambling</member><member>peer-to-peer</member><member>questionable</member><member>weapons</member>
                  <member>dynamic-dns</member><member>encrypted-dns</member><member>hacking</member><member>insufficient-content</member><member>newly-registered-domain</member><member>not-resolved</member><member>parked</member><member>proxy-avoidance-and-anonymizers</member><member>unknown</member>
                  <member>AI-code-assistant</member><member>AI-conversational-assistant</member><member>AI-data-and-workflow-optimizer</member><member>AI-meeting-assistant</member><member>AI-platform-service</member><member>AI-writing-assistant</member>
                </block>
                <alert><member>business-and-economy</member></alert>
                <credential-enforcement>
                  <mode><domain-credentials/></mode>
                  <block>
                    <member>command-and-control</member><member>compromised-website</member><member>grayware</member><member>malware</member><member>phishing</member><member>ransomware</member><member>scanning-activity</member>
                    <member>abused-drugs</member><member>adult</member><member>copyright-infringement</member><member>extremism</member><member>gambling</member><member>peer-to-peer</member><member>questionable</member><member>weapons</member>
                    <member>dynamic-dns</member><member>encrypted-dns</member><member>hacking</member><member>insufficient-content</member><member>newly-registered-domain</member><member>not-resolved</member><member>parked</member><member>proxy-avoidance-and-anonymizers</member><member>unknown</member>
                    <member>AI-code-assistant</member><member>AI-conversational-assistant</member><member>AI-data-and-workflow-optimizer</member><member>AI-meeting-assistant</member><member>AI-platform-service</member><member>AI-writing-assistant</member>
                  </block>
                </credential-enforcement>
                <log-container-page-only>no</log-container-page-only>
                <cloud-inline-cat>yes</cloud-inline-cat>
                <mlav-engine-urlbased-enabled>
                  <entry name="Phishing Detection"><mlav-policy-action>block</mlav-policy-action></entry>
                </mlav-engine-urlbased-enabled>
              </entry>
              <entry name="loose-url">
                <block><member>malware</member></block>
                <allow><member>web-advertisements</member></allow>
                <credential-enforcement>
                  <mode><ip-user/></mode>
                  <allow><member>shopping</member></allow>
                </credential-enforcement>
              </entry>
            </url-filtering>
            <file-blocking>
              <entry name="reference-fb">
                <rules>
                  <entry name="block-risky">
                    <application><member>any</member></application>
                    <direction>both</direction>
                    <action>block</action>
                    <file-type><member>7z</member><member>bat</member><member>chm</member><member>class</member><member>cpl</member><member>dll</member><member>hlp</member><member>hta</member><member>jar</member><member>ocx</member><member>pif</member><member>scr</member><member>torrent</member><member>vbe</member><member>wsf</member></file-type>
                  </entry>
                  <entry name="alert-rest">
                    <application><member>any</member></application>
                    <direction>both</direction>
                    <action>alert</action>
                    <file-type><member>any</member></file-type>
                  </entry>
                </rules>
              </entry>
              <entry name="drifted-fb">
                <rules>
                  <entry name="block-some">
                    <application><member>any</member></application>
                    <direction>both</direction>
                    <action>block</action>
                    <file-type><member>7z</member><member>exe</member></file-type>
                  </entry>
                  <entry name="continue-encrypted">
                    <application><member>any</member></application>
                    <direction>both</direction>
                    <action>continue</action>
                    <file-type><member>encrypted-zip</member></file-type>
                  </entry>
                </rules>
              </entry>
            </file-blocking>
            <wildfire-analysis>
              <entry name="forward-all-wf">
                <cloud-inline-analysis>yes</cloud-inline-analysis>
                <rules>
                  <entry name="all">
                    <application><member>any</member></application>
                    <file-type><member>any</member></file-type>
                    <direction>both</direction>
                    <analysis>public-cloud</analysis>
                  </entry>
                </rules>
              </entry>
              <entry name="narrow-wf">
                <rules>
                  <entry name="uploads-only">
                    <application><member>web-browsing</member></application>
                    <file-type><member>pe</member></file-type>
                    <direction>upload</direction>
                    <analysis>public-cloud</analysis>
                  </entry>
                </rules>
              </entry>
            </wildfire-analysis>
          </profiles>
          <log-settings>
            <profiles>
              <entry name="lfp-default">
                <match-list>
                  <entry name="traffic"><log-type>traffic</log-type><send-to-panorama>yes</send-to-panorama></entry>
                  <entry name="threat"><log-type>threat</log-type><send-syslog><member>siem</member></send-syslog></entry>
                  <entry name="wildfire"><log-type>wildfire</log-type><send-syslog><member>siem</member></send-syslog></entry>
                  <entry name="url"><log-type>url</log-type><send-syslog><member>siem</member></send-syslog></entry>
                  <entry name="auth"><log-type>auth</log-type><send-syslog><member>siem</member></send-syslog></entry>
                </match-list>
              </entry>
              <entry name="hollow-lfp">
                <match-list>
                  <entry name="threat-nowhere"><log-type>threat</log-type><send-to-panorama>no</send-to-panorama></entry>
                </match-list>
              </entry>
            </profiles>
          </log-settings>
          <rulebase>
            <security>
              <rules>
                <entry name="good-rule" uuid="00000000-0000-0000-0000-000000000001">
                  <description>Allows web from trust to untrust</description>
                  <from><member>trust</member></from>
                  <to><member>untrust</member></to>
                  <source><member>10.0.0.0/24</member></source>
                  <destination><member>any</member></destination>
                  <application><member>web-browsing</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                  <log-end>yes</log-end>
                  <log-setting>lfp-default</log-setting>
                  <profile-setting><group><member>strict-group</member></group></profile-setting>
                </entry>
                <entry name="naked-allow" uuid="00000000-0000-0000-0000-000000000002">
                  <from><member>trust</member></from>
                  <to><member>untrust</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                  <log-end>no</log-end>
                </entry>
                <entry name="thin-group-allow" uuid="00000000-0000-0000-0000-000000000003">
                  <description>Group attached but group lacks core profiles</description>
                  <from><member>trust</member></from>
                  <to><member>untrust</member></to>
                  <source><member>10.0.0.0/24</member></source>
                  <destination><member>198.51.100.7</member></destination>
                  <application><member>ssl</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                  <log-setting>lfp-default</log-setting>
                  <profile-setting><group><member>thin-group</member></group></profile-setting>
                </entry>
                <entry name="individual-profiles" uuid="00000000-0000-0000-0000-000000000004">
                  <description>Individually attached core profiles</description>
                  <from><member>trust</member></from>
                  <to><member>untrust</member></to>
                  <source><member>10.0.0.0/24</member></source>
                  <destination><member>198.51.100.8</member></destination>
                  <application><member>dns</member></application>
                  <service><member>application-default</member></service>
                  <action>allow</action>
                  <log-setting>lfp-default</log-setting>
                  <profile-setting>
                    <profiles>
                      <virus><member>strict-av</member></virus>
                      <spyware><member>strict-as</member></spyware>
                      <vulnerability><member>strict-vp</member></vulnerability>
                    </profiles>
                  </profile-setting>
                </entry>
                <entry name="deny-rule" uuid="00000000-0000-0000-0000-000000000005">
                  <from><member>untrust</member></from>
                  <to><member>trust</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>deny</action>
                  <log-setting>lfp-default</log-setting>
                </entry>
                <entry name="disabled-bad-rule" uuid="00000000-0000-0000-0000-000000000006">
                  <disabled>yes</disabled>
                  <from><member>trust</member></from>
                  <to><member>untrust</member></to>
                  <source><member>any</member></source>
                  <destination><member>any</member></destination>
                  <application><member>any</member></application>
                  <service><member>any</member></service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </rulebase>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
